FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/runner ./cmd/runner

# The runner needs pg_dump/psql, so it cannot be scratch-based.
FROM postgres:16-alpine
RUN addgroup -g 10001 -S runner && adduser -u 10001 -S runner -G runner
COPY --from=build /out/runner /usr/local/bin/runner
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/runner"]

